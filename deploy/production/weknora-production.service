[Unit]
Description=WeKnora production application stack
Wants=network-online.target
After=network-online.target docker.service weknora-production.slice
Requires=docker.service weknora-production.slice
PartOf=docker.service
RequiresMountsFor=/srv/weknora-production /data/weknora-production
ConditionPathExists=/srv/weknora-production/current/images.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash /srv/weknora-production/bin/start.sh
TimeoutStartSec=10min
UMask=0077

[Install]
WantedBy=multi-user.target
